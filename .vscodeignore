# Exclude files not needed at runtime from the packaged extension.
# Must keep: extension.js, lib/, l10n/, media/ (including the codicons LICENSE), package.json, package.nls*.json,
#            LICENSE, README.md, CHANGELOG.md, THIRD_PARTY_NOTICES.md

# Version control and repository config
.git/**
.github/**
.gitignore
.gitattributes
.vscode/**
.vscode-test/**
.editorconfig
.eslintrc*
.prettierrc*
jsconfig.json
tsconfig.json

# Development files
test/**
docs/**
bin/**
images/**
scripts/**
coverage/**
DEVLOG.md
SUPPORT.md
SECURITY.md
README.*.md
**/*.map
**/*.log
**/.DS_Store
*.vsix
.env
.env.*
